# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Tool caches
.mypy_cache/
.ruff_cache/
.pytest_cache/

# Obsidian 本地配置（workspace 记录窗口布局，随机器和操作变化）
notes/.obsidian/

# 站点生成物（CI 每次构建重生成，不入库）
docs/content/

# 会话与检索日志不入库；Day 6 / Day 7 各保留一份示例日志作笔记实证，
# 它们是已跟踪文件，gitignore 规则不能否定已跟踪文件，因此不会被移除。
phase2/day06/logs/*
!phase2/day06/logs/session-20261122-154748-371904.json
phase2/day07/logs/*
!phase2/day07/logs/retrieval-example.json

# 本机工具配置（launch.json 里是本机 venv 的绝对路径）
.claude/

# 本机编辑器配置（解释器选择、调试配置随机器而异，不入库）
.vscode/

# archify 候选稿与回执（成品 HTML 在 notes/phase*/dayNN/assets/ 下）
.archify/
notes/phase*/day*/assets/*.finalize.json
notes/phase*/day*/assets/*.finalize-summary.json
notes/phase*/day*/assets/*.browser-check.json
notes/phase*/day*/assets/*.delivery.json

# archify 出图的临时工作目录（成品已复制到 notes/phase*/dayNN/assets/）
.archify/
